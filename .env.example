# Public Supabase client configuration. Required for sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never prefix these with NEXT_PUBLIC_.
TAVUS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Coordinator provisions these after the provider configuration smoke check.
TAVUS_PAL_ID=
TAVUS_FACE_ID=
ELEVENLABS_VOICE_ID=
# A random server capability; its hash is provisioned in the private DB schema.
SESSION_SERVER_SECRET=
