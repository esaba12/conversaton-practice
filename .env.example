# Public Supabase client configuration. Required for sign-in.
# Google sign-in is turned on in the Supabase dashboard (Authentication → Providers).
# Allowlist this app origin's /auth/callback. No Google secret belongs in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never prefix these with NEXT_PUBLIC_.
TAVUS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Setup-draft model ID for the OpenAI Responses API (structured outputs). Required for generation.
OPENAI_SETUP_MODEL=
# Optional reflection model ID (Responses API, structured outputs). Falls back to OPENAI_SETUP_MODEL when empty.
OPENAI_REFLECTION_MODEL=
# Coordinator provisions these after the provider configuration smoke check.
TAVUS_PAL_ID=
TAVUS_FACE_ID=
ELEVENLABS_VOICE_ID=
# Wow pass (SPIKE-01). Quality PAL candidate: not active until the owner's A/B call switches TAVUS_PAL_ID.
TAVUS_QUALITY_PAL_ID=
TAVUS_QUALITY_FACE_ID=
# Stand-in for "Show me first" (W10). Server-only; the face is never used by a person preset.
TAVUS_STANDIN_PAL_ID=
TAVUS_STANDIN_FACE_ID=
ELEVENLABS_STANDIN_VOICE_ID=
# A random server capability; its hash is provisioned in the private DB schema.
SESSION_SERVER_SECRET=
